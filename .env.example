# Copia este archivo a .env si quieres variables locales. .env no se versiona.
# Ningún valor de aquí es un secreto real.

NODE_ENV=development
PORT=3001
APP_DISPLAY_NAME=TraeLo

# Solo desarrollo local. No es una credencial de producción.
DATABASE_URL=postgresql://comprausa:comprausa@127.0.0.1:5432/comprausa

# simulated arranca solo si NODE_ENV=development.
# Producción: none | resend (email, free tier) | twilio (SMS + email vía Verify).
# El código no sale en logs ni en /v1/auth/otp/challenges. En desarrollo simulated
# se lee en POST /v1/auth/dev/otp-code.
OTP_PROVIDER=simulated

# Resend (OTP_PROVIDER=resend). Solo email; teléfono responde otp_channel_unsupported.
# RESEND_API_KEY=
# OTP_EMAIL_FROM=TraeLo <otp@tu-dominio.com>

# Twilio Verify (OTP_PROVIDER=twilio). Implementado en API pero oculto en la UI
# (PHONE_OTP_ENABLED=false) por coste de SMS. No activar en clientes de prueba.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# OAuth (Google / Apple). Comma-separated client IDs accepted as ID token audiences.
# GOOGLE_CLIENT_IDS=xxxx.apps.googleusercontent.com
# APPLE_CLIENT_IDS=com.traelo.web
# Web build:
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# NEXT_PUBLIC_APPLE_CLIENT_ID=com.traelo.web
# Expo:
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# EXPO_PUBLIC_APPLE_CLIENT_ID=com.traelo.app

# En producción hace falta un valor de 32 caracteres o más, distinto del marcador
# de desarrollo que vive en el código. Déjalo vacío en local.
AUTH_TOKEN_SECRET=

# Origen del sitio para CORS. Si se omite en development, se usa http://localhost:3000.
# WEB_ORIGIN=http://localhost:3000

# Clientes (no son secretos; van embebidos en el build).
# Web: NEXT_PUBLIC_API_URL=https://comprausaapi-production.up.railway.app
# Expo: EXPO_PUBLIC_API_URL — iOS Simulator http://127.0.0.1:3001
#       Android Emulator http://10.0.2.2:3001
#       Dispositivo físico: IP LAN o URL pública de Railway (nunca localhost).
# NEXT_PUBLIC_API_URL=
# EXPO_PUBLIC_API_URL=

# Stripe solo acepta sk_test_. Una clave sk_live_ impide arrancar. Déjalas vacías:
# CI no llama a Stripe y el repositorio no guarda una clave.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Instrucciones de cobro manual. Vacías hasta que el negocio las escriba. No inventan una cuenta.
ZELLE_INSTRUCTIONS=
PAGO_MOVIL_BANK=
PAGO_MOVIL_PHONE=
PAGO_MOVIL_HOLDER=

# Reservado. PayPal no captura en este corte.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
REDIS_URL=
