# Copia este archivo a .env si quieres variables locales. .env no se versiona.
# Ningún valor de aquí es un secreto real.

NODE_ENV=development
PORT=3001
APP_DISPLAY_NAME=CompraUSA VE

# Solo desarrollo local. No es una credencial de producción.
DATABASE_URL=postgresql://comprausa:comprausa@127.0.0.1:5432/comprausa

# simulated arranca solo si NODE_ENV=development. Producción tiene que usar none.
# El código no sale en logs ni en /v1/auth/otp/challenges. En desarrollo se lee en
# POST /v1/auth/dev/otp-code.
OTP_PROVIDER=simulated

# En producción hace falta un valor de 32 caracteres o más, distinto del marcador
# de desarrollo que vive en el código. Déjalo vacío en local.
AUTH_TOKEN_SECRET=

# Origen del sitio para CORS. Si se omite en development, se usa http://localhost:3000.
# WEB_ORIGIN=http://localhost:3000

# Reservado para incrementos posteriores. Déjalos vacíos.
# No habilitar Stripe hasta confirmar elegibilidad legal y geográfica.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
REDIS_URL=
